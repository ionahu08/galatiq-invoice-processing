# LLM Configuration
# Use "anthropic" for Claude or "xai" for Grok
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022

# API Keys (provide appropriate key for your LLM provider)
ANTHROPIC_API_KEY=sk-ant-...
XAI_API_KEY=xai-...  # For Grok API

# System Configuration
DATABASE_PATH=inventory.db
INVOICES_DIR=data/invoices
LOGS_DIR=logs

# Agent Configuration
APPROVAL_THRESHOLD=10000.0
MAX_RETRIES=2
TIMEOUT_SECONDS=30

# Feature Flags
ENABLE_LOGGING=true
ENABLE_OBSERVABILITY=true
DEBUG_MODE=false
